AddHandler application/x-lsphp84 .php
AddType application/x-lsphp84 .php

# Esconde versao do servidor
ServerSignature Off
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloqueia diretorios sensiveis (codigo fonte, config, dependencias)
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^\.git(/|$) - [F,L,NC]
    RewriteRule ^app(/|$) - [F,L,NC]
    RewriteRule ^bootstrap(/|$) - [F,L,NC]
    RewriteRule ^config(/|$) - [F,L,NC]
    RewriteRule ^database(/|$) - [F,L,NC]
    RewriteRule ^resources(/|$) - [F,L,NC]
    RewriteRule ^routes(/|$) - [F,L,NC]
    RewriteRule ^storage(/|$) - [F,L,NC]
    RewriteRule ^tests(/|$) - [F,L,NC]
    RewriteRule ^vendor(/|$) - [F,L,NC]
    RewriteRule ^node_modules(/|$) - [F,L,NC]

    # Bloqueia arquivos sensiveis na raiz
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js|phpunit\.xml|artisan|README\.md|LICENSE|\.editorconfig|\.gitignore|\.gitattributes|\.npmrc)$ - [F,L,NC]

    # Roteia tudo o que sobrou para dentro de public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Defesa extra: nega qualquer arquivo iniciado com ponto
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# E nega arquivos comuns de projeto que escaparam
<FilesMatch "(?i)^(composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js|phpunit\.xml|artisan|README\.md|LICENSE)$">
    Require all denied
</FilesMatch>
